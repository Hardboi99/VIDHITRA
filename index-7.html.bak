  <meta name="twitter:title" content="Vidhitra Corporate Advisors LLP | Fractional General Counsel" />
  <meta name="twitter:description" content="Ongoing legal counsel integrated with your business — corporate law, commercial contracts, regulatory compliance, and cross-jurisdictional support across India." />
  <meta name="twitter:image" content="assets/images/og-image.jpg" />

  <!-- Theme colour (browser UI tint on mobile) — client brand teal -->
