  <script>
(function () {
  const list = document.querySelector('.tj-approach-list');
  if (!list) return;

  const items = Array.from(list.querySelectorAll('.tj-approach-item'));
  let ticking = false;

  function update() {
    ticking = false;
    const vh = window.innerHeight;

    items.forEach((item) => {
      const rect = item.getBoundingClientRect();
      const itemCenter = rect.top + rect.height / 2;

      // Item "arrives" once its center crosses this line (60% down viewport),
      // and "leaves" (resets) once it crosses back above 85% or below the top.
      const triggerLine = vh * 0.75;

      if (itemCenter < triggerLine) {
        item.classList.add('is-inview');
      } else {
        item.classList.remove('is-inview');
      }
    });
  }

  function onScroll() {
    if (!ticking) {
      requestAnimationFrame(update);
      ticking = true;
    }
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('wheel', onScroll, { passive: true });
  window.addEventListener('touchmove', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  update();
})();


// Scroll-triggered reveal for About section — same threshold pattern as Approach section
(function () {
  const targets = document.querySelectorAll(
    '.h6-about-content, .vidhitra-about-visual'
    
  );
  if (!targets.length) return;

  let ticking = false;

  function update() {
    ticking = false;
    const vh = window.innerHeight;
    const triggerLine = vh * 0.85;

    targets.forEach((el) => {
      const rect = el.getBoundingClientRect();
      if (rect.top < triggerLine && rect.bottom > 0) {
        el.classList.add('is-inview');
      } else {
        el.classList.remove('is-inview');
      }
    });
  }

  function onScroll() {
    if (!ticking) {
      requestAnimationFrame(update);
      ticking = true;
    }
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('wheel', onScroll, { passive: true });
  window.addEventListener('touchmove', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  update();
})();
  </script>
