<script>
/* ============ Contact form: validation + animated feedback ============ */
(function () {
  const form = document.getElementById('tjClientEnquiryForm');
  if (!form) return;

  const successMsg = document.getElementById('tjFormSuccess');

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    let isValid = true;

    // required inputs / textarea / select
    form.querySelectorAll('.tj-form-field').forEach((field) => {
      const control = field.querySelector('input, select, textarea');
      if (!control) return;
      const required = control.hasAttribute('required');
      const filled = control.value && control.value.trim().length > 0;

      field.classList.remove('tj-field-invalid');
      if (required && !filled) {
        isValid = false;
        field.classList.add('tj-field-invalid');
        // restart shake animation if triggered twice in a row
        void field.offsetWidth;
      }
    });

    // consent checkbox
    const consentWrap = document.querySelector('.tj-consent-check');
    const consentInput = document.getElementById('cuConsent');
    consentWrap.classList.remove('tj-field-invalid');
    if (!consentInput.checked) {
      isValid = false;
      consentWrap.classList.add('tj-field-invalid');
    }

    if (!isValid) {
      successMsg.classList.remove('is-visible');
      return;
    }

    // Replace this block with your actual submit call (fetch/AJAX to your
    // form handler or CRM endpoint) — this just simulates success.
    successMsg.classList.add('is-visible');
    form.reset();
    form.querySelectorAll('.tj-form-field').forEach((f) => f.classList.remove('tj-field-invalid'));

    window.setTimeout(() => successMsg.classList.remove('is-visible'), 5000);
  });
})();
</script>

