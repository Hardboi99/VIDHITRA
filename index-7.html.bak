  <!-- Primary SEO Meta Tags -->
  <meta name="description" content="Vidhitra Corporate Advisors LLP provides Fractional General Counsel services — ongoing legal counsel integrated with your business, covering corporate law, commercial contracts, regulatory compliance, and cross-jurisdictional matters across India." />
  <meta name="keywords" content="Fractional General Counsel, Corporate Advisory, Corporate Law Firm India, Commercial Contracts, Regulatory Compliance, Legal Counsel for Business, Vidhitra Corporate Advisors" />
  <meta name="author" content="Vidhitra Corporate Advisors LLP" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://www.vidhitra.com/" />

  <!-- Site Title -->
  <title>Vidhitra Corporate Advisors LLP | Fractional General Counsel</title>

  <!-- Open Graph / Facebook / LinkedIn -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://www.vidhitra.com/" />
  <meta property="og:title" content="Vidhitra Corporate Advisors LLP | Fractional General Counsel" />
  <meta property="og:description" content="Ongoing legal counsel integrated with your business — corporate law, commercial contracts, regulatory compliance, and cross-jurisdictional support across India." />
  <meta property="og:image" content="assets/images/og-image.jpg" />
  <meta property="og:site_name" content="Vidhitra Corporate Advisors LLP" />
  <meta property="og:locale" content="en_IN" />

  <!-- Twitter / X Card -->
